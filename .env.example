# ResearchMind — environment variable template
# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored and must never be committed.

# --- External API keys (optional) ---
SEMANTIC_SCHOLAR_API_KEY=your_key_here
LLM_API_KEY=your_key_here

# --- LLM configuration ---
# LLM_PROVIDER: "anthropic" | "openai" | "none"
# If "none" or LLM_API_KEY is unset, RAG/chatbot answers fall back to a
# transparent extractive summary of retrieved papers instead of failing.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# --- Embedding / vector backend overrides (optional) ---
# Leave unset to auto-detect (sentence-transformers/faiss if installed,
# otherwise the documented TF-IDF/numpy fallback).
# EMBEDDING_BACKEND=sentence-transformers
# VECTOR_BACKEND=faiss
EMBEDDING_MODEL_NAME=all-mpnet-base-v2
EMBEDDING_BATCH_SIZE=32

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Search / ranking ---
DEFAULT_TOP_K=10
RANK_W_SEMANTIC=0.65
RANK_W_CITATION=0.15
RANK_W_RECENCY=0.10
RANK_W_QUALITY=0.10

# --- RAG ---
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=6000

# --- Logging ---
LOG_LEVEL=INFO
